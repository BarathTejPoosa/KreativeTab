---
import { ViewTransitions } from "astro:transitions";
import Head from "@/components/Head.astro";
import Footer from "@/components/footers/Footer.astro";
import Navigation from "@/components/headers/Navigation.astro";
import LinesWrapper from "@/components/primitives/LinesWrapper.astro";
import LoadingIndicator from "@/components/primitives/LoadingIndicator.astro";
import Widget from "@/components/primitives/Widget.astro";
import { getLocalizedSettings } from "@/lib/localization-helpers";
import type { SEOProps } from "astro-seo";

const currentLocale = Astro.currentLocale;

const { widget } = getLocalizedSettings(currentLocale);

type Props = {
	seo?: SEOProps | MinimalSeo;
};

const { seo } = Astro.props;
---

<html lang={currentLocale}>
	<Head seo={seo}>
		<script is:inline>document.documentElement.classList.add('js-enabled');</script>
		<ViewTransitions />
	</Head>
	<body>
		<LoadingIndicator />
		<LinesWrapper />
		<Navigation showTopBar />
		<slot />
		{widget.enabled && <Widget />}
		<Footer />
	</body>
</html>

<script>
	function initScrollReveal() {
		let staggerDelay = 0;
		let staggerTimeout;

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.style.transitionDelay = `${staggerDelay * 0.15}s`;
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
						
						staggerDelay++;
						clearTimeout(staggerTimeout);
						staggerTimeout = setTimeout(() => {
							staggerDelay = 0;
						}, 100);
					}
				});
			},
			{
				threshold: 0.1,
				rootMargin: "0px 0px -50px 0px",
			}
		);

		const selectors = [
			"section h1", "section h2", "section h3", "section h4", "section h5", "section h6", 
			"section p", "section .button-primary", "section img", "section .work-item", "section .blog-item"
		];
		
		document.querySelectorAll(selectors.join(", ")).forEach((el) => {
			if (!el.classList.contains("is-visible") && !el.closest(".no-reveal")) {
				el.classList.add("reveal-target");
				observer.observe(el);
			}
		});
	}

	// Run on initial load and subsequent navigations (ViewTransitions)
	document.addEventListener("astro:page-load", initScrollReveal);
</script>
