---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Container from "@/components/primitives/Container.astro";
import BaseLayout from "./BaseLayout.astro";

type Props = {
	frontmatter: CollectionEntry<"pages">;
};

const { frontmatter } = Astro.props;
const { seo: pageSeo } = frontmatter.data;

// Optional custom share image set in the CMS; otherwise Head uses the generated og.png
const customImage = pageSeo.image
	? await getImage({ src: pageSeo.image, width: 1200, format: "jpg" })
	: undefined;

const seo: PageSeo = {
	title: pageSeo.title,
	description: pageSeo.description,
	author: pageSeo.author,
	noindex: pageSeo.noindex,
	...(customImage
		? {
				image: customImage.src,
				imageWidth: Number(customImage.attributes.width),
				imageHeight: Number(customImage.attributes.height),
				imageAlt: frontmatter.data.title,
			}
		: {}),
};
---

<BaseLayout seo={seo}>
	<main>
		{
			frontmatter.data.hideTitle ? null : (
				<header class="py-32 lg:pt-40 lg:pb-36">
					<Container
						tag="div"
						class="mx-0 flex justify-center items-center gap-10"
					>
						<div class="items-center text-sm font-medium justify-center flex min-h-[auto]">
							<div class="items-center flex-col w-full m-auto text-[clamp(2.375rem,3.5vw,3.1875rem)] leading-[1.08] font-semibold">
								<div class="items-center text-center flex-col justify-start flex gap-2 leading-[1.15]">
									<h1 class="my-3 mx-0 max-w-screen-sm">
										{frontmatter.data.title}
									</h1>
									<h2 class="text-2xl lg:text-3xl max-w-screen-sm">
										{frontmatter.data.subtitle}
									</h2>
								</div>
							</div>
						</div>
					</Container>
				</header>
			)
		}
		<slot />
	</main>
</BaseLayout>
