---
import { Image, getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Container from "@/components/primitives/Container.astro";
import Prose from "@/components/primitives/Prose.astro";
import Share from "@/components/primitives/Share.astro";
import Title from "@/components/primitives/Title.astro";
import { translatePath, unlocalizedUrl } from "@/lib/localization-helpers";
import { absoluteUrl, breadcrumbJsonLd, organizationId, withTrailingSlash } from "@/lib/seo";
import { defaultLocale } from "site";
import BaseLayout from "./BaseLayout.astro";

type Props = {
	frontmatter: CollectionEntry<"posts">;
};

const currentLocale = Astro.currentLocale;

interface PostLayoutLocale {
	writtenBy: string;
	writtenAt: string;
	news: string;
	example: string;
}

interface ComponentLocales {
	[key: string]: PostLayoutLocale;
}

const componentLocales: ComponentLocales = {
	it: {
		writtenBy: "Scritto da: ",
		writtenAt: "nel",
		news: "News",
		example: "Articolo di esempio: contenuto segnaposto.",
	},
	en: {
		writtenBy: "Written by: ",
		writtenAt: "on",
		news: "News",
		example: "Example article: placeholder content.",
	},
};

const l = componentLocales[currentLocale ?? defaultLocale];

const { frontmatter } = Astro.props;

const post = frontmatter.data;
const locale = currentLocale ?? defaultLocale;
const coverAlt = post.coverAlt ?? `Cover image for ${post.title}`;
const path = withTrailingSlash(
	translatePath(locale, `/post${unlocalizedUrl(`/${frontmatter.slug}`)}`),
);
const ogImage = await getImage({ src: post.cover, width: 1200, format: "jpg" });

const seo: PageSeo = {
	title: post.seo?.title ?? `${post.title} | KreativeTab`,
	description: post.seo?.description ?? post.description,
	author: post.author,
	noindex: post.seo?.noindex,
	image: ogImage.src,
	imageWidth: Number(ogImage.attributes.width),
	imageHeight: Number(ogImage.attributes.height),
	imageAlt: coverAlt,
	type: "article",
	publishedTime: post.pubDate,
	modifiedTime: post.lastUpdateDate,
	tags: post.tags,
	section: post.category,
	jsonLd: [
		{
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			"@id": `${absoluteUrl(path)}#article`,
			headline: post.title,
			description: post.description,
			url: absoluteUrl(path),
			mainEntityOfPage: absoluteUrl(path),
			inLanguage: locale,
			image: absoluteUrl(ogImage.src),
			datePublished: post.pubDate.toISOString(),
			dateModified: post.lastUpdateDate.toISOString(),
			author: { "@type": "Person", name: post.author },
			publisher: { "@id": organizationId },
			...(post.tags.length ? { keywords: post.tags.join(", ") } : {}),
		},
		breadcrumbJsonLd([
			{ name: "Home", path: translatePath(locale, "/") },
			{ name: l.news, path: translatePath(locale, "/news") },
			{ name: post.title, path },
		]),
	],
};
---

<BaseLayout seo={seo}>
	<section class="py-32 md:py-56">
		<Container>
			<div class="text-center">
				{
					"author" in frontmatter.data &&
						frontmatter?.data?.author &&
						"pubDate" in frontmatter.data &&
						frontmatter?.data?.pubDate && (
							<div class="inline-flex items-center gap-4 pb-4 lg:pb-6">
								<span class="text-xs font-semibold uppercase tracking-wide text-black">
									<span>
										{l.writtenBy} {frontmatter.data?.author}
										{l.writtenAt}
									</span>
									{frontmatter.data?.pubDate
										?.toString()
										.slice(0, 10)}
								</span>
							</div>
						)
				}

				{
					post.example && (
						<p class="mx-auto mb-6 block w-fit rounded-full border border-amber-400 bg-amber-50 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-amber-700">
							{l.example}
						</p>
					)
				}
				<Title level={1}>{frontmatter.data.title}</Title>
				<p class="mx-auto max-w-2xl pt-8 text-base text-slate-500">
					<em>{frontmatter.data?.description}</em>
				</p>
			</div>
			<div class="flex w-full flex-col items-center justify-center pt-12">
				<ul class="flex flex-wrap justify-center gap-3">
					{
						"tags" in frontmatter.data &&
							frontmatter.data?.tags?.map((tag: unknown) => (
								<li class="list-none rounded-full border border-slate-300 px-4 py-2 text-sm">
									{tag}
								</li>
							))
					}
				</ul>
				{
					"cover" in frontmatter.data && frontmatter.data?.cover && (
						<Image
							class="mt-12 w-full lg:w-auto lg:min-w-[50rem]"
							src={frontmatter.data?.cover}
							alt={coverAlt}
						/>
					)
				}
				<Prose><slot /></Prose>
				<div class="mx-auto w-full max-w-3xl pt-20">
					<Share />
				</div>
			</div>
		</Container>
	</section>
</BaseLayout>
