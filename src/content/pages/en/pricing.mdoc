   faqs=[{question: "Are these prices fixed?", answer: "Yes. You get a fixed price and a written scope before we start, and you only pay more if you ask for something outside that scope, priced and agreed first."}, {question: "What is included in every website?", answer: "Copywriting, Google Business Profile set-up and an easy CMS so you can edit text and photos yourself. Sites are built in Astro for speed and SEO."}, {question: "Do I have to take a care plan?", answer: "No. Care plans are optional, have no minimum term and you can cancel any time."}, {question: "Are app store fees included?", answer: "No. Apple charges $99 a year and Google $25 one-off for developer accounts. The app is published under your own accounts, so you own it."}, {question: "Where are you based?", answer: "Based in Derby, happy to meet locally. We also work by call and email."}]
