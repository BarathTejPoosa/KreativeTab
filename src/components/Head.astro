---
import { pwaAssetsHead } from "virtual:pwa-assets/head";
import { pwaInfo } from "virtual:pwa-info";
import "@/styles/global.css";
import { getLocalizedSettings } from "@/lib/localization-helpers";
import {
	absoluteUrl,
	jsonLdString,
	organizationJsonLd,
	websiteJsonLd,
	withTrailingSlash,
} from "@/lib/seo";
import { SEO, type SEOProps } from "astro-seo";
import { defaultLocale, isIndexable, localeTags, siteTitle } from "site.config";

type Props = {
	seo?: PageSeo;
};

const currentLocale = Astro.currentLocale ?? defaultLocale;

const { seo: defaultSeo, style } = getLocalizedSettings(currentLocale);

const seo: PageSeo = Astro.props.seo ?? {};

const pathname = withTrailingSlash(Astro.url.pathname);
const canonicalURL = absoluteUrl(pathname);

const title = seo.title || defaultSeo.title;
const description = seo.description || defaultSeo.description;
const author = seo.author || defaultSeo.author || siteTitle;

// Default share image: the 1200×630 card generated for every CMS page at <path>/og.png
const shareImage = seo.image ? absoluteUrl(seo.image) : absoluteUrl(`${pathname}og.png`);
const imageWidth = seo.image ? seo.imageWidth : 1200;
const imageHeight = seo.image ? seo.imageHeight : 630;
const imageAlt = seo.imageAlt || title;

const noindex = !isIndexable || Boolean(seo.noindex);
const twitterHandle = defaultSeo.twitterHandle
	? `@${defaultSeo.twitterHandle.replace(/^@/, "")}`
	: undefined;
const ogLocale = localeTags[currentLocale as keyof typeof localeTags] ?? "en_GB";
const type = seo.type ?? "website";

const seoProps: SEOProps = {
	title,
	description,
	charset: "UTF-8",
	canonical: canonicalURL,
	noindex,
	nofollow: noindex,
	openGraph: {
		basic: { url: canonicalURL, title, type, image: shareImage },
		optional: {
			description,
			siteName: siteTitle,
			locale: ogLocale,
		},
		image: {
			url: shareImage,
			secureUrl: shareImage,
			type: shareImage.endsWith(".png") ? "image/png" : shareImage.match(/\.jpe?g$/) ? "image/jpeg" : undefined,
			width: imageWidth,
			height: imageHeight,
			alt: imageAlt,
		},
		...(type === "article"
			? {
					article: {
						publishedTime: seo.publishedTime?.toISOString(),
						modifiedTime: seo.modifiedTime?.toISOString(),
						authors: [author],
						section: seo.section,
						tags: seo.tags,
					},
				}
			: {}),
	},
	twitter: {
		card: "summary_large_image",
		site: twitterHandle,
		creator: twitterHandle,
		title,
		description,
		image: shareImage,
		imageAlt,
	},
	extend: {
		meta: [
			{ name: "author", content: author },
			{ name: "publisher", content: siteTitle },
			{ name: "msapplication-TileColor", content: style.theme.colors.tileColor },
		],
	},
};

const jsonLd = [
	organizationJsonLd(getLocalizedSettings(defaultLocale).seo.description),
	websiteJsonLd(currentLocale),
	...(seo.jsonLd ?? []),
];
---

<head>
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />

	<SEO {...seoProps} />
	<script type="application/ld+json" is:inline set:html={jsonLdString(jsonLd)} />
	<link rel="alternate" type="application/rss+xml" title={`${siteTitle} blog`} href="/rss.xml" />

	{
		pwaAssetsHead.themeColor && (
			<meta
				name="theme-color"
				content={pwaAssetsHead.themeColor.content}
			/>
		)
	}
	{pwaAssetsHead.links.map((link) => <link {...link} />)}
	{pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
	<script src="/src/utils/pwa.ts"></script>

	<!-- PRECONNECT FONTS -->
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

	<!-- FONTS -->
	<link
		href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700&display=swap"
		rel="stylesheet"
	/>

	<!-- LIBS -->
	<script
		defer
		src="https://cdn.jsdelivr.net/npm/@alpinejs/focus@3.13.5/dist/cdn.min.js"
	></script>
	<script
		defer
		src="https://cdn.jsdelivr.net/npm/@ryangjchandler/alpine-clipboard@2.3.0/dist/alpine-clipboard.js"
	></script>

	<slot />
</head>
