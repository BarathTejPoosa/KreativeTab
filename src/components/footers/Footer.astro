---
import Container from "@/components/primitives/Container.astro";
import { getLocalizedSettings, translatePath, unlocalizedUrl } from "@/lib/localization-helpers";
import { defaultLocale, locales } from "site";
import { hasPublishedPosts, isNewsLink } from "@/lib/posts";

const currentLocale = Astro.currentLocale ?? defaultLocale;
const { footer, contacts, header } = getLocalizedSettings(currentLocale);
const year = new Date().getFullYear();
const showNews = await hasPublishedPosts(currentLocale);
const navPages = header.pages.filter((page) => showNews || !isNewsLink(page.link));
const it = currentLocale === "it";
const t = it
	? { haveProject: "Hai un progetto?", services: "Servizi", explore: "Esplora", talk: "Parliamo", form: "Scrivici dal modulo", rights: "Tutti i diritti riservati.", location: "Derby, UK" }
	: { haveProject: "Have a project?", services: "Services", explore: "Explore", talk: "Start a conversation", form: "Use the contact form", rights: "All rights reserved.", location: "Derby, UK" };
const primaryAction = footer.buttons?.[0];

function getTranslatedUrl(locale: string): string {
	return translatePath(locale, unlocalizedUrl(Astro.url.pathname));
}
---

<footer class="bg-black text-white">
	<section class="bg-brand-flare py-12 text-black lg:py-16">
		<Container>
			<div class="grid gap-8 lg:grid-cols-12 lg:items-end">
				<div class="lg:col-span-2">
					<p class="text-xs font-semibold uppercase tracking-[0.2em]">{t.haveProject}</p>
				</div>
				<div class="lg:col-span-7">
					<h2 class="m-0 max-w-3xl font-display text-[clamp(1.75rem,2.8vw,2.375rem)] font-semibold leading-tight tracking-normal text-black" set:html={footer.title} />
				</div>
				<div class="lg:col-span-3 lg:flex lg:justify-end">
					{primaryAction && (
						<a href={translatePath(currentLocale, primaryAction.url)} class="inline-flex min-h-11 items-center bg-black px-5 text-sm font-semibold text-white transition-colors hover:bg-white hover:text-black">
							{primaryAction.text}<span class="ml-2" aria-hidden="true">↗</span>
						</a>
					)}
				</div>
			</div>
		</Container>
	</section>

	<div data-cursor-theme="dark" class="py-14 lg:py-20">
		<Container>
			<div class="grid gap-12 border-b border-white/15 pb-14 md:grid-cols-2 lg:grid-cols-12 lg:pb-20">
				<div class="lg:col-span-4">
					<a href={translatePath(currentLocale, "/")} aria-label="KreativeTab home" class="inline-block">
						<img src="/brand/kreativetab-logo.svg" alt="KreativeTab" class="h-6 w-auto invert" />
					</a>
					<p class="mt-6 max-w-sm text-base leading-relaxed text-white/55">
						{footer.tagline ?? "Derby-based studio for brand kits, websites, web apps and mobile apps."}
					</p>
				</div>

				{footer.services && footer.services.length > 0 && (
					<div class="lg:col-span-3">
						<p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-white/45">{t.services}</p>
						<ul class="space-y-3">
							{footer.services.map((service) => (
								<li><a href={translatePath(currentLocale, service.link || "/services")} class="text-sm font-medium text-white/75 transition-colors hover:text-brand-flare">{service.title}</a></li>
							))}
						</ul>
					</div>
				)}

				<nav class="lg:col-span-2" aria-label="Footer navigation">
					<p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-white/45">{t.explore}</p>
					<ul class="space-y-3">
						{navPages.map((page) => (
							<li><a href={translatePath(currentLocale, page.link)} class="text-sm font-medium text-white/75 transition-colors hover:text-brand-flare">{page.title}</a></li>
						))}
					</ul>
				</nav>

				<div class="lg:col-span-3">
					<p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-white/45">{t.talk}</p>
					{contacts.mail ? (
						<a href={`mailto:${contacts.mail}`} class="break-all text-base font-medium text-brand-flare transition-colors hover:text-white">{contacts.mail}</a>
					) : (
						<a href={translatePath(currentLocale, "/contact")} class="text-base font-medium text-brand-flare transition-colors hover:text-white">{t.form}</a>
					)}
					<p class="mt-3 text-sm text-white/55">{t.location}</p>
				</div>
			</div>

			<div class="flex flex-col gap-5 pt-7 text-xs text-white/50 md:flex-row md:items-center md:justify-between">
				<p>&copy; {year} KreativeTab. {t.rights}</p>
				<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
					{locales.map((locale) => (
						<a href={getTranslatedUrl(locale)} class:list={["uppercase transition-colors hover:text-white", locale === currentLocale && "text-brand-flare"]}>{locale}</a>
					))}
					<a href="/privacy" class="transition-colors hover:text-white">Privacy</a>
					<a href="/terms" class="transition-colors hover:text-white">Terms</a>
				</div>
			</div>
		</Container>
	</div>
</footer>

<slot />
