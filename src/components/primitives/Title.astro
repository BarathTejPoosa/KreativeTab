---
interface Props {
	level?: 1 | 2 | 3 | 4 | 5 | 6;
	tag?: 1 | 2 | 3 | 4 | 5 | 6;
	class?: string;
	[key: string]: unknown;
}

let { level = 2, tag, class: className, ...rest } = Astro.props as Props;

tag = tag ?? level;

const Element = `h${tag}` as const;
---

<Element
	class:list={[
		level === 1 && "text-[clamp(2.375rem,3.5vw,3.1875rem)] leading-[1.08]",
		level === 2 && "text-[clamp(1.75rem,2.8vw,2.375rem)] leading-tight",
		level === 3 && "text-[clamp(1.3125rem,2vw,1.75rem)] leading-tight",
		level === 4 && "text-xl md:text-2xl",
		level === 5 && "text-lg md:text-xl",
		level === 6 && "text-lg md:text-xl",
		className,
	]}
	{...rest}
>
	<slot />
</Element>
