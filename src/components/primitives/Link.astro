---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import { defaultLocale } from "site.config";

const currentLocale = Astro.currentLocale;

export interface Props {
	href?: string;
	tag?: "a" | "button";
	size?: "xs" | "sm" | "md" | "lg";
	block?: boolean;
	style?: "primary" | "button" | "outline" | "buttonLight";
	icon?: string;
	class?: string;
	localized?: boolean;
	[x: string]: unknown;
}

export type LinkType = Props & {
	title?: string;
};

const {
	href,
	block,
	icon,
	size = "md",
	style = "primary",
	localized = true,
	class: className,
	...rest
} = Astro.props as Props;

const sizes = {
	xs: "min-h-9 px-3 text-xs",
	sm: "min-h-10 px-4 text-sm",
	md: "min-h-11 px-5 text-sm",
	lg: "min-h-12 px-6 text-base",
};

const iconSizes = {
	xs: 16,
	sm: 18,
	md: 20,
	lg: 22,
};

const Tag = Astro.props.tag || "a";

if (Tag === "a" && !href) {
	throw new Error("The `href` prop is required when using the `a` tag.");
}

const styles = {
	primary: "text-black underline decoration-1 underline-offset-4 transition-colors hover:text-brand-charcoal",
	button: "button-primary items-center gap-2 border border-brand-flare bg-brand-flare text-brand-ink font-semibold hover:border-white hover:bg-white",
	buttonLight: "button-primary items-center gap-2 border border-white bg-transparent text-white font-semibold hover:bg-white hover:text-black",
	outline: "button-primary items-center gap-2 border border-black bg-transparent text-black font-semibold hover:bg-black hover:text-white",
};
---

<Tag
	href={localized && href?.startsWith("/")
		? getRelativeLocaleUrl(currentLocale ?? defaultLocale, href)
		: href}
	class:list={[
		block ? "flex" : "inline-flex",
		style != "primary" ? sizes[size] : null,
		style != "primary" ? "justify-center" : null,
		styles[style],
		className,
	]}
	{...rest}
>
	<slot />
	{icon && <Icon name={icon} size={iconSizes[size]} />}
</Tag>

<style>
	.button-primary {
		transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
	}
	.button-primary [data-icon="iconamoon:arrow-top-right-1-thin"] {
		transition: transform 180ms ease;
	}
	.button-primary:hover [data-icon="iconamoon:arrow-top-right-1-thin"] {
		transform: translate(2px, -2px);
	}
</style>
