---
import { type CollectionEntry, getCollection } from "astro:content";
import BlogPreview from "@/components/sections/BlogPreview.astro";

const currentLocale = Astro.currentLocale;

const posts = await getCollection("posts");

const recentPosts = posts
	.map((post) => {
		const [lang, ...slug] = post.slug.split("/");
		return {
			...post,
			lang: lang,
			slug: post.slug.startsWith("/") ? post.slug : `/${post.slug}`,
		};
	})
	.filter((post) => post.lang === currentLocale && !post.data.hidden && !post.data.example)
	.sort(
		(a, b) =>
			b.data.lastUpdateDate.getTime() - a.data.lastUpdateDate.getTime(),
	)
	.slice(0, 3) as CollectionEntry<"posts">[];

interface Props {
	title: string;
}

const { title } = Astro.props;
// Example (placeholder) posts never show on the homepage; the section hides until a real post exists.
---

{recentPosts.length > 0 && (

<section
	data-cursor-theme="dark"
	class="relative left-1/2 right-1/2 -mx-[50vw] w-screen bg-black text-white"
>
	<div class="mx-auto w-full max-w-[90rem] px-5 lg:px-10 py-24 lg:py-32">
		<h2 class="font-display text-[clamp(1.75rem,2.8vw,2.375rem)] font-semibold leading-tight text-white mb-16">
			{title}
		</h2>
		<div
			class="gap-x-[1.88rem] auto-cols-fr grid-cols-1 lg:grid-cols-3 grid-rows-[auto] gap-y-12 grid"
		>
			{recentPosts.map((post) => <BlogPreview {post} />)}
		</div>
	</div>
</section>
)}
