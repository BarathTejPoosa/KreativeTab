---
import { Image } from "astro:assets";
import googleWhite from "@/assets/pages/homepage/google-white.png";

interface Props {
	testimonial: string;
	name: string;
}

const { testimonial, name } = Astro.props;
---

<section
	data-cursor-theme="dark"
	class="relative left-1/2 right-1/2 -mx-[50vw] w-screen bg-black text-white"
>
	<div class="mx-auto w-full max-w-[90rem] px-5 lg:px-10 py-24 lg:py-32 flex items-center justify-center">
		<div class="text-center max-w-3xl">
			<Image
				src={googleWhite}
				alt="Google logo"
				class="object-contain align-middle inline-block w-full h-10 max-w-[8.13rem] mb-12"
			/>
			<h2 class="font-display text-[clamp(1.75rem,2.8vw,2.375rem)] font-semibold leading-tight text-white mb-8">
				"{testimonial}"
			</h2>
			<div class="w-12 h-px bg-brand-flare/60 mx-auto mb-6"></div>
			<p class="text-white/60 text-sm uppercase tracking-[0.2em] font-semibold">{name}</p>
		</div>
	</div>
</section>
