---
import { getCollection } from "astro:content";
import type { ButtonProps } from "@/components/primitives/Button.astro";
import RecentWorksTunnel from "@/components/sections/RecentWorksTunnel";
import { translatePath, unlocalizedUrl } from "@/lib/localization-helpers";
import { defaultLocale } from "site";

const currentLocale = Astro.currentLocale ?? defaultLocale;
const works = await getCollection("works");

const recentWorks = works
	.map((work) => {
		const [lang] = work.slug.split("/");
		return { ...work, lang };
	})
	.filter((work) => work.lang === currentLocale && !work.data.hidden)
	.sort((a, b) => b.data.lastUpdateDate.getTime() - a.data.lastUpdateDate.getTime())
	.slice(0, 4);

interface Props {
	title: string;
	buttons?: ButtonProps[];
	tunnelImages?: string[];
}

const { title, buttons = [], tunnelImages } = Astro.props as Props;
const allWorkButton = buttons[0];
const allWorkHref = translatePath(currentLocale, allWorkButton?.href ?? "/works");

const tunnelWorks = recentWorks.map((work) => ({
	title: work.data.title,
	tags: work.data.tags.join(", "),
	href: translatePath(currentLocale, `/work${unlocalizedUrl(`/${work.slug}`)}`),
}));

const fallbackImages = recentWorks.map((work) => work.data.cover.src);
const images = tunnelImages && tunnelImages.length > 0 ? tunnelImages : fallbackImages;
---

<div class="relative left-1/2 right-1/2 -mx-[50vw] w-screen">
	<RecentWorksTunnel
		client:visible
		{title}
		{images}
		works={tunnelWorks}
		{allWorkHref}
		allWorkLabel={allWorkButton?.title ?? "View all work"}
	/>
</div>
