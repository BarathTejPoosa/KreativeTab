---
import Button from "@/components/primitives/Button.astro";
import { getLocalizedSettings } from "@/lib/localization-helpers";
import { defaultLocale } from "site";

type HTMLInputTypeAttribute =
	| "button"
	| "checkbox"
	| "color"
	| "date"
	| "datetime-local"
	| "email"
	| "file"
	| "hidden"
	| "image"
	| "month"
	| "number"
	| "password"
	| "radio"
	| "range"
	| "reset"
	| "search"
	| "submit"
	| "tel"
	| "text"
	| "time"
	| "url"
	| "week";

type FormFieldType = HTMLInputTypeAttribute | "textarea" | "submit";

interface FormField {
	title: string;
	placeholder?: string;
	type: FormFieldType;
	required?: boolean;
	width?: 1 | 2;
}

interface Props {
	title: string;
	fields: FormField[];
}

const { title, fields } = Astro.props;

const locale = Astro.currentLocale ?? defaultLocale;
const { contacts } = getLocalizedSettings(locale);
const it = locale === "it";
const t = it
	? { location: "Con base a Derby, UK. Felici di incontrarti in zona.", sending: "Invio in corso…", sent: "Grazie! Messaggio inviato, ti risponderemo presto.", failed: "Invio non riuscito. Riprova o scrivici via email.", mailto: "Si aprirà la tua app email con il messaggio pronto da inviare.", subject: "Nuova richiesta dal sito KreativeTab", interest: "Mi interessa il pacchetto" }
	: { location: "Based in Derby, UK. Happy to meet locally.", sending: "Sending…", sent: "Thanks! Your message has been sent and we will get back to you soon.", failed: "Sorry, that did not send. Please try again or email us.", mailto: "Your email app will open with the message ready to send.", subject: "New enquiry from the KreativeTab website", interest: "I'm interested in the package" };

// Free form backend: set PUBLIC_WEB3FORMS_KEY (from web3forms.com) to send submissions by email.
// Without a key the form opens the visitor's email app with the message filled in.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
const fieldName = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, "") || "field";
---

<section
	data-cursor-theme="dark"
	class="relative left-1/2 right-1/2 -mx-[50vw] w-screen bg-black text-white"
>
	<div class="mx-auto w-full max-w-[90rem] px-5 lg:px-10 py-24 lg:py-32">
		<div class="max-w-3xl">
			<h2 class="font-display text-[clamp(1.75rem,2.8vw,2.375rem)] font-semibold leading-tight text-white mb-12">
				{title}
			</h2>
			<p class="-mt-8 mb-12 text-base text-white/60">{t.location}</p>
			<form
				data-contact-form
				data-access-key={accessKey || undefined}
				data-mail={contacts.mail || undefined}
				data-subject={t.subject}
				data-interest={t.interest}
				data-msg-sending={t.sending}
				data-msg-sent={t.sent}
				data-msg-failed={t.failed}
				data-msg-mailto={t.mailto}
				method="post"
				action={accessKey ? "https://api.web3forms.com/submit" : undefined}
				class="auto-cols-fr grid-cols-1 sm:grid-cols-2 grid-rows-[auto] grid gap-8">
				{
					fields?.map((field) => {
						if (field.type === "submit") {
							return (
								<Button type="submit" class:list={[field.width == 2 && "sm:col-span-2"]}>
									{field.title}
								</Button>
							);
						} else if (field.type === "textarea") {
							return (
								<div class:list={["text-base", field.width == 2 && "sm:col-span-2"]}>
									<p class="text-white/70 font-semibold max-w-full mb-3 text-sm uppercase tracking-[0.1em]">
										{field.title}
									</p>
									<textarea
										name={fieldName(field.title)}
										aria-label={field.title}
										required={field.required}
										placeholder={field.placeholder}
										class="text-white cursor-text py-4 px-5 w-full bg-white/5 border border-white/15 rounded-md m-0 placeholder:text-white/30 focus:outline-none focus:border-brand-flare/60 transition-colors min-h-[8rem]"
									/>
								</div>
							);
						} else {
							return (
								<div class:list={["text-base", field.width == 2 && "sm:col-span-2"]}>
									<p class="text-white/70 font-semibold max-w-full mb-3 text-sm uppercase tracking-[0.1em]">
										{field.title}
									</p>
									<input
										type={field.type as HTMLInputTypeAttribute}
										name={field.type === "email" ? "email" : fieldName(field.title)}
										aria-label={field.title}
										required={field.required}
										placeholder={field.placeholder}
										class="text-white cursor-text py-4 px-5 w-full h-14 min-h-[3.50rem] bg-white/5 border border-white/15 rounded-md m-0 placeholder:text-white/30 focus:outline-none focus:border-brand-flare/60 transition-colors"
									/>
								</div>
							);
						}
					})
				}
				<input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />
				<p data-form-status role="status" aria-live="polite" class="sm:col-span-2 m-0 text-sm text-brand-flare empty:hidden"></p>
			</form>
		</div>
	</div>
</section>

<script>
	for (const form of document.querySelectorAll<HTMLFormElement>("form[data-contact-form]")) {
		const d = form.dataset;
		const status = form.querySelector<HTMLElement>("[data-form-status]");
		const message = form.querySelector<HTMLTextAreaElement>("textarea");
		const pkg = new URLSearchParams(location.search).get("package");
		if (pkg && message && !message.value) message.value = `${d.interest}: ${pkg}\n\n`;

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const data = new FormData(form);
			if (data.get("botcheck")) return;
			data.delete("botcheck");
			if (d.accessKey) {
				data.set("access_key", d.accessKey);
				data.set("subject", d.subject ?? "Website enquiry");
				data.set("from_name", "KreativeTab website");
				if (status) status.textContent = d.msgSending ?? "";
				try {
					const res = await fetch("https://api.web3forms.com/submit", { method: "POST", headers: { Accept: "application/json" }, body: data });
					const json = await res.json();
					if (!res.ok || !json.success) throw new Error(json.message);
					form.reset();
					if (status) status.textContent = d.msgSent ?? "";
				} catch {
					if (status) status.textContent = d.msgFailed ?? "";
				}
				return;
			}
			if (!d.mail) return;
			const lines = [...data.entries()].map(([key, value]) => `${key.replace(/_/g, " ")}: ${value}`);
			if (status) status.textContent = d.msgMailto ?? "";
			location.href = `mailto:${d.mail}?subject=${encodeURIComponent(d.subject ?? "")}&body=${encodeURIComponent(lines.join("\n"))}`;
		});
	}
</script>
