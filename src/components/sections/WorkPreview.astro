---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { translatePath, unlocalizedUrl } from "@/lib/localization-helpers";
import { defaultLocale } from "site";

interface Props {
	work: CollectionEntry<"works">;
	/** Load eagerly (first row of the grid). */
	eager?: boolean;
	headingLevel?: "h2" | "h3";
}

const { work, eager = false, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const currentLocale = Astro.currentLocale ?? defaultLocale;
const href = translatePath(currentLocale, `/work${unlocalizedUrl(`/${work.slug}`)}`);
const { title, category, cover, coverAlt, example, client } = work.data;
---

<article class="work-tile" data-category={category ?? "Branding"}>
	<a
		href={href}
		class="group relative block aspect-[4/3] overflow-hidden rounded-xl bg-neutral-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black"
	>
		<Image
			src={cover}
			widths={[480, 800, 1200]}
			sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
			alt={coverAlt ?? `Cover for ${title}`}
			loading={eager ? "eager" : "lazy"}
			class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
		/>
		{
			example && (
				<span class="absolute left-3 top-3 rounded-full bg-amber-300 px-2.5 py-0.5 text-[0.7rem] font-semibold uppercase tracking-wide text-amber-950">
					Example
				</span>
			)
		}
		<div class="tile-overlay absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/80 via-black/25 to-transparent p-5 text-white transition-opacity duration-300">
			<Heading class="m-0 text-lg font-semibold leading-snug !text-white">{title}</Heading>
			<p class="mt-1 text-sm text-white/80">
				{category}{client && !example ? ` · ${client}` : ""}
			</p>
		</div>
	</a>
</article>

<style>
	/* Mouse users: title and category appear on hover. Touch screens: always shown. */
	@media (hover: hover) and (pointer: fine) {
		.tile-overlay {
			opacity: 0;
		}
		a:hover .tile-overlay,
		a:focus-visible .tile-overlay {
			opacity: 1;
		}
	}
</style>
