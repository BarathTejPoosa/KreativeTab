---
import type { ButtonProps } from "@/components/primitives/Button.astro";
import Container from "@/components/primitives/Container.astro";
import Link from "@/components/primitives/Link.astro";
import { PrismStage } from "@/components/originkit/ui/hero-10/prism-stage";
import { Image } from "astro:assets";
import brandStrategyImg from "@/assets/hero/brand-strategy.jpg";
import webDesignImg from "@/assets/hero/web-design.jpg";
import growthCreativeImg from "@/assets/hero/growth-creative.jpg";

interface Props {
	title: string;
	subtitle: string;
	buttons?: ButtonProps[];
}

const { title, subtitle, buttons = [] } = Astro.props;
---

<section id="hero" data-cursor-theme="dark" class="relative isolate bg-black pb-8 pt-20 text-white lg:pb-10 lg:pt-28 overflow-hidden min-h-screen">
	{/* Add the Originkit backgrounds for the cool effect while keeping the original layout */}
	<PrismStage client:load />

	<Container class="relative z-10 pointer-events-none flex flex-col h-full justify-center mt-12">
		<div class="pointer-events-auto grid items-center gap-12 pb-20 pt-8 lg:grid-cols-12 lg:gap-8 lg:pb-24 lg:pt-12">
			<div class="lg:col-span-7">
				<h1
					class="m-0 max-w-3xl font-display text-[clamp(2.375rem,3.5vw,3.1875rem)] leading-[1.08] text-white"
					set:html={title}
				/>
			</div>

			<div class="flex flex-col lg:col-span-4 lg:col-start-9">
				<p class="m-0 max-w-xl text-[clamp(1rem,1.4vw,1.3125rem)] leading-relaxed text-white/75" set:html={subtitle} />
				<div class="mt-8 flex flex-wrap gap-3">
					{buttons.map(({ title, href, style, icon }) => (
						<Link
							href={href}
							style={style as "primary" | "button" | "outline" | "buttonLight"}
							icon={icon}
						>
							{title}
						</Link>
					))}
				</div>
			</div>
		</div>

		<div class="pointer-events-auto grid gap-4 pt-7 pb-12 text-sm text-white/65 sm:grid-cols-3">
			<div class="group relative cursor-pointer w-fit">
				<p>Brand strategy</p>
				<div class="absolute top-full left-0 mt-4 w-64 opacity-0 scale-95 pointer-events-none group-hover:opacity-100 group-hover:scale-100 transition-all duration-300 origin-top-left z-50 overflow-hidden shadow-2xl border border-white/10 bg-black/40 backdrop-blur-md">
					<Image src={brandStrategyImg} alt="Brand strategy work" class="w-full h-32 object-cover" />
					<div class="p-4">
						<p class="text-white text-xs font-semibold uppercase tracking-wider mb-1">NexaCore Systems</p>
						<p class="text-white/60 text-xs line-clamp-2">Identity & positioning designed for industrial growth.</p>
					</div>
				</div>
			</div>
			
			<div class="group relative cursor-pointer w-fit">
				<p>Web design & build</p>
				<div class="absolute top-full left-0 mt-4 w-64 opacity-0 scale-95 pointer-events-none group-hover:opacity-100 group-hover:scale-100 transition-all duration-300 origin-top-left z-50 overflow-hidden shadow-2xl border border-white/10 bg-black/40 backdrop-blur-md">
					<Image src={webDesignImg} alt="Web design work" class="w-full h-32 object-cover" />
					<div class="p-4">
						<p class="text-white text-xs font-semibold uppercase tracking-wider mb-1">Quantum Flow</p>
						<p class="text-white/60 text-xs line-clamp-2">High-performance digital experiences and scalable architecture.</p>
					</div>
				</div>
			</div>
			
			<div class="group relative cursor-pointer w-fit">
				<p>Growth creative</p>
				<div class="absolute top-full left-0 mt-4 w-64 opacity-0 scale-95 pointer-events-none group-hover:opacity-100 group-hover:scale-100 transition-all duration-300 origin-top-left z-50 overflow-hidden shadow-2xl border border-white/10 bg-black/40 backdrop-blur-md">
					<Image src={growthCreativeImg} alt="Growth creative work" class="w-full h-32 object-cover" />
					<div class="p-4">
						<p class="text-white text-xs font-semibold uppercase tracking-wider mb-1">Skyward Tech</p>
						<p class="text-white/60 text-xs line-clamp-2">Impactful campaigns and continuous creative assets.</p>
					</div>
				</div>
			</div>
		</div>
	</Container>
</section>
