---
import type { ButtonProps } from "@/components/primitives/Button.astro";
import Container from "@/components/primitives/Container.astro";
import Link from "@/components/primitives/Link.astro";
import { PrismStage } from "@/components/originkit/ui/hero-10/prism-stage";
import { Image } from "astro:assets";
import brandKitImg from "@/assets/pages/services/branding.jpg";
import websiteImg from "@/assets/pages/services/web-design.jpg";
import webAppImg from "@/assets/pages/services/web-apps.jpg";
import mobileAppImg from "@/assets/pages/services/product-design.jpg";
import { translatePath } from "@/lib/localization-helpers";
import { defaultLocale } from "site";

interface Props {
	title: string;
	subtitle: string;
	buttons?: ButtonProps[];
}

const { title, subtitle, buttons = [] } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const it = locale === "it";
const services = [
	{ label: it ? "Brand kit" : "Brand kits", anchor: it ? "brand-kit" : "brand-kits", img: brandKitImg, text: it ? "Logo, colori, font e linee guida." : "Logo, colours, fonts and guidelines." },
	{ label: it ? "Siti web" : "Websites", anchor: it ? "siti-web" : "websites", img: websiteImg, text: it ? "Siti in Astro, testi e Google Business Profile inclusi." : "Astro sites with copy and Google Business Profile included." },
	{ label: it ? "Web app" : "Web apps", anchor: it ? "web-app" : "web-apps", img: webAppImg, text: it ? "Strumenti e MVP in Next.js e React." : "Tools and MVPs built in Next.js and React." },
	{ label: it ? "App mobile" : "Mobile apps", anchor: it ? "app-mobile" : "mobile-apps", img: mobileAppImg, text: it ? "App iPhone e Android in React Native (Expo)." : "iPhone and Android apps in React Native (Expo)." },
];
---

<section id="hero" data-cursor-theme="dark" class="relative isolate bg-black pb-8 pt-20 text-white lg:pb-10 lg:pt-28 overflow-hidden min-h-screen">
	{/* Add the Originkit backgrounds for the cool effect while keeping the original layout */}
	<PrismStage client:load />

	<Container class="relative z-10 pointer-events-none flex flex-col h-full justify-center mt-12">
		<div class="pointer-events-auto grid items-center gap-12 pb-20 pt-8 lg:grid-cols-12 lg:gap-8 lg:pb-24 lg:pt-12">
			<div class="lg:col-span-7">
				<h1
					class="m-0 max-w-3xl font-display text-[clamp(2.375rem,3.5vw,3.1875rem)] leading-[1.08] text-white"
					set:html={title}
				/>
			</div>

			<div class="flex flex-col lg:col-span-4 lg:col-start-9">
				<p class="m-0 max-w-xl text-[clamp(1rem,1.4vw,1.3125rem)] leading-relaxed text-white/75" set:html={subtitle} />
				<div class="mt-8 flex flex-wrap gap-3">
					{buttons.map(({ title, href, style, icon }) => (
						<Link
							href={href}
							style={style as "primary" | "button" | "outline" | "buttonLight"}
							icon={icon}
						>
							{title}
						</Link>
					))}
				</div>
			</div>
		</div>

		<div class="pointer-events-auto grid grid-cols-2 gap-4 pt-7 pb-12 text-sm text-white/65 sm:grid-cols-4">
			{services.map((service) => (
				<a href={`${translatePath(locale, "/services")}#${service.anchor}`} class="group relative w-fit transition-colors hover:text-white">
					<p>{service.label}</p>
					<div class="absolute top-full left-0 mt-4 w-64 opacity-0 scale-95 pointer-events-none group-hover:opacity-100 group-hover:scale-100 transition-all duration-300 origin-top-left z-50 overflow-hidden shadow-2xl border border-white/10 bg-black/40 backdrop-blur-md">
						<Image src={service.img} alt="" width={512} class="w-full h-32 object-cover" />
						<div class="p-4">
							<p class="text-white text-xs font-semibold uppercase tracking-wider mb-1">{service.label}</p>
							<p class="text-white/60 text-xs line-clamp-2">{service.text}</p>
						</div>
					</div>
				</a>
			))}
		</div>
	</Container>
</section>
