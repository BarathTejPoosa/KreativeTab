---
import { Image } from "astro:assets";
import about from "@/assets/pages/about/about.png";

const { title, subtitle, content } = Astro.props;
---

<section
	data-cursor-theme="dark"
	class="relative left-1/2 right-1/2 -mx-[50vw] w-screen bg-black text-white"
>
	<div class="mx-auto w-full max-w-[90rem] px-5 lg:px-10 py-24 lg:py-32">
		<div class="relative w-full h-[50em] overflow-hidden mb-16">
			<Image
				src={about}
				alt="About"
				class="absolute inset-0 w-full h-full object-cover"
			/>
		</div>
		<div class="auto-cols-fr grid-cols-1 lg:grid-cols-[.6fr_1fr] grid-rows-[auto] grid gap-[1.88rem]">
			<div class="col-span-1 row-span-1">
				<h2 class="font-display text-[clamp(1.75rem,2.8vw,2.375rem)] font-semibold leading-tight text-white">
					{title}
				</h2>
			</div>
			<div class="col-span-1 row-span-1 text-white/75 text-lg">
				<p class="mb-4" set:html={subtitle} />
				<p set:html={content} />
			</div>
		</div>
	</div>
</section>
