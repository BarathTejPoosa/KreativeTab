---
import { getLocalizedSettings, translatePath } from "@/lib/localization-helpers";
import { defaultLocale } from "site";

const currentLocale = Astro.currentLocale ?? defaultLocale;
const { header } = getLocalizedSettings(currentLocale);
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrentPage(path: string) {
	const localizedPath = translatePath(currentLocale, path).replace(/\/$/, "") || "/";
	return currentPath === localizedPath;
}
---

<header data-site-header class="fixed inset-x-0 top-0 z-50 border-b border-brand-ink/10 bg-brand-paper transition-transform duration-300 ease-out">
	<div class="mx-auto flex h-14 max-w-[1440px] items-center px-5 lg:px-10">
		<a
			href={translatePath(currentLocale, "/")}
			class="inline-flex min-h-11 shrink-0 items-center"
			aria-label="KreativeTab home"
		>
			<img src="/brand/kreativetab-logo.svg" alt="KreativeTab" class="h-5 w-auto lg:h-6" />
		</a>

		<nav class="ml-auto hidden h-full items-center lg:flex" aria-label="Primary navigation">
			<ul class="flex h-full items-center gap-8">
				{header.pages.map((page) => (
					<li class="h-full">
						<a
							href={translatePath(currentLocale, page.link)}
							aria-current={isCurrentPage(page.link) ? "page" : undefined}
							class:list={[
								"relative flex h-full items-center text-sm font-medium transition-colors after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:bg-brand-signal after:transition-transform",
								isCurrentPage(page.link)
									? "text-brand-signal after:scale-x-100"
									: "text-brand-charcoal hover:text-brand-signal after:scale-x-0 hover:after:scale-x-100",
							]}
						>
							{page.title}
						</a>
					</li>
				))}
			</ul>
			<span class="mx-7 h-6 w-px bg-brand-ink/15"></span>
			<a
				href={translatePath(currentLocale, "/contact")}
				class="inline-flex min-h-10 items-center gap-2 bg-brand-flare px-4 text-sm font-semibold text-brand-ink transition-colors hover:bg-brand-ink hover:text-white"
			>
				Start a project <span aria-hidden="true">↗</span>
			</a>
		</nav>

		<details class="group ml-auto lg:hidden">
			<summary
				class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-end [&::-webkit-details-marker]:hidden"
				aria-label="Open navigation"
			>
				<span class="menu-lines relative h-4 w-6"></span>
			</summary>
			<nav class="absolute inset-x-0 top-16 border-b border-brand-ink/10 bg-brand-paper px-5 py-5" aria-label="Mobile navigation">
				<ul class="divide-y divide-brand-ink/10">
					{header.pages.map((page) => (
						<li>
							<a
								href={translatePath(currentLocale, page.link)}
								aria-current={isCurrentPage(page.link) ? "page" : undefined}
								class:list={[
									"flex min-h-12 items-center justify-between py-3 text-base font-medium",
									isCurrentPage(page.link) ? "text-brand-signal" : "text-brand-ink",
								]}
							>
								{page.title}<span aria-hidden="true">↗</span>
							</a>
						</li>
					))}
				</ul>
				<a href={translatePath(currentLocale, "/contact")} class="mt-5 flex min-h-12 items-center justify-center bg-brand-flare px-5 font-semibold text-brand-ink">
					Start a project
				</a>
			</nav>
		</details>
	</div>
</header>

<style>
	.menu-lines::before,
	.menu-lines::after {
		content: "";
		position: absolute;
		left: 0;
		width: 100%;
		height: 2px;
		background: var(--color-ink);
		transition: transform 180ms ease, top 180ms ease;
	}
	.menu-lines::before { top: 2px; }
	.menu-lines::after { top: 12px; }
	details[open] .menu-lines::before { top: 7px; transform: rotate(45deg); }
	details[open] .menu-lines::after { top: 7px; transform: rotate(-45deg); }
</style>

<script>
	let cleanupHeaderScroll = () => {};

	function initializeHeaderScroll() {
		cleanupHeaderScroll();

		const header = document.querySelector<HTMLElement>("[data-site-header]");
		const mobileMenu = header?.querySelector<HTMLDetailsElement>("details");
		if (!header) return;

		let previousY = window.scrollY;
		let ticking = false;

		const showHeader = () => header.classList.remove("-translate-y-full");
		const hideHeader = () => header.classList.add("-translate-y-full");

		const update = () => {
			const currentY = window.scrollY;
			const delta = currentY - previousY;
			const menuOpen = mobileMenu?.open ?? false;
			const hasFocus = header.contains(document.activeElement);

			if (currentY <= 16 || menuOpen || hasFocus || delta < -4) {
				showHeader();
			} else if (delta > 6 && currentY > 80) {
				hideHeader();
			}

			previousY = currentY;
			ticking = false;
		};

		const onScroll = () => {
			if (!ticking) {
				window.requestAnimationFrame(update);
				ticking = true;
			}
		};

		const onMenuToggle = () => {
			if (mobileMenu?.open) showHeader();
		};

		window.addEventListener("scroll", onScroll, { passive: true });
		mobileMenu?.addEventListener("toggle", onMenuToggle);

		cleanupHeaderScroll = () => {
			window.removeEventListener("scroll", onScroll);
			mobileMenu?.removeEventListener("toggle", onMenuToggle);
		};
	}

	initializeHeaderScroll();
	document.addEventListener("astro:page-load", initializeHeaderScroll);
</script>
